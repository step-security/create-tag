{
  "name": "create-tag",
  "version": "1.0.0",
  "private": true,
  "description": "Tag a git commit with a semantic version",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "jest",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/create-tag.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "step-security",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^8.0.0",
    "axios": "^1.20.0",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^14.10.0",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.0.0",
    "eslint-plugin-github": "^4.1.1",
    "eslint-plugin-jest": "^27.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.0.0",
    "prettier": "2.1.1",
    "ts-jest": "^29.0.0",
    "typescript": "^4.9.5"
  }
}
